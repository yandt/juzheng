<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Label 必须与 helper 标识一致，launchd 用它索引服务 -->
    <key>Label</key>
    <string>com.zhanghui.juzheng.helper</string>

    <!-- helper 二进制路径。安装时由主 app 替换为实际部署路径 -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/libexec/juzheng-helper</string>
    </array>

    <!-- 以 root 运行（LaunchDaemons 默认就是 root，显式声明更清晰） -->
    <key>UserName</key>
    <string>root</string>

    <!-- 开机/加载时立即启动 -->
    <key>RunAtLoad</key>
    <true/>

    <!-- 崩溃后自动重启，保证常驻 -->
    <key>KeepAlive</key>
    <true/>

    <!-- 日志输出到文件，便于调试 -->
    <key>StandardOutPath</key>
    <string>/var/log/juzheng-helper.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/juzheng-helper.log</string>
</dict>
</plist>
